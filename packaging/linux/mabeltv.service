[Unit]
Description=Mabel TV appliance
After=local-fs.target sound.target systemd-udev-settle.service mabeltv-ir.service
Wants=systemd-udev-settle.service
Conflicts=getty@tty1.service
OnFailure=mabeltv-recovery.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=90s
TimeoutStartSec=300s
User=mabeltv
Group=mabeltv
SupplementaryGroups=audio video render input
WorkingDirectory=/var/lib/mabeltv
StateDirectory=mabeltv
StateDirectoryMode=0750
CacheDirectory=mabeltv
CacheDirectoryMode=0750
LogsDirectory=mabeltv
LogsDirectoryMode=0750
RuntimeDirectory=mabeltv
RuntimeDirectoryMode=0750
Environment=HOME=/var/lib/mabeltv
Environment=XDG_CONFIG_HOME=/var/lib/mabeltv
Environment=XDG_DATA_HOME=/var/lib/mabeltv
Environment=XDG_CACHE_HOME=/var/cache/mabeltv
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_kms
Environment=QT_QPA_EGLFS_KMS_CONFIG=/run/mabeltv/kms.json
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
Environment=QT_QPA_EGLFS_KMS_ATOMIC=1
Environment=MABELTV_HIDE_CURSOR=1
# libmpv/FFmpeg replaces several worker threads at programme boundaries.
# Limit glibc's per-thread arenas so freed decoder buffers are reused instead
# of leaving a new fragmented 16-64 MB heap behind after every hand-off.
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_TRIM_THRESHOLD_=131072
# The launcher selects the connected HDMI socket, matching ALSA device, and a
# Pi-model-appropriate decoder. Environment overrides remain available for
# unusual display or audio hardware.
# Debian 13 libmpv 0.40/0.41 leaks one GL sync-file descriptor for every
# embedded OpenGL frame (mpv #17217). Request the compatible renderer and mask
# Mesa's sync extensions so libmpv cannot enter the affected path until a
# distro libmpv containing upstream fix f74adc4 is installed.
Environment=MABELTV_FORCE_GLES2=1
Environment=MESA_GLES_VERSION_OVERRIDE=2.0
Environment=MESA_GL_VERSION_OVERRIDE=2.1
Environment="MESA_EXTENSION_OVERRIDE=-GL_ARB_sync -GL_APPLE_sync"
ExecStart=/opt/mabeltv/current/mabeltv-launch
ExecStopPost=+/usr/local/libexec/mabeltv-stop-report ${SERVICE_RESULT} ${EXIT_CODE} ${EXIT_STATUS}
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=0
TimeoutStopSec=15
KillSignal=SIGTERM
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
StandardOutput=journal
StandardError=journal
OOMScoreAdjust=-300
MemoryHigh=700M
MemoryMax=850M
TasksMax=128
LimitNOFILE=4096
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
ReadWritePaths=/var/lib/mabeltv /var/cache/mabeltv /var/log/mabeltv /run/mabeltv

[Install]
WantedBy=multi-user.target
