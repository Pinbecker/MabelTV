#!/usr/bin/env bash
# Physical-presence parent PIN recovery. Creating mabeltv-reset-pin on the
# SD-card boot partition rotates the one-time setup code without touching media.
set -Eeuo pipefail

boot_root=/boot/firmware
[[ -d "$boot_root" ]] || boot_root=/boot
marker="$boot_root/mabeltv-reset-pin"
[[ -e "$marker" ]] || exit 0

pending="/var/lib/mabeltv/owner-recovery-pending"
state_tool=/opt/mabeltv/current/mabeltv-state-migrate
[[ -x "$state_tool" ]] || {
    printf 'The active release does not provide the SQLite recovery tool.\n' >&2
    exit 1
}
install -d -o mabeltv -g mabeltv -m 0750 /var/lib/mabeltv/recovery

if "$state_tool" owner-status --database /var/lib/mabeltv/mabeltv.db \
        >/dev/null 2>&1; then
    recovery="$(mktemp -d /var/lib/mabeltv/recovery/owner-reset-XXXXXXXX)"
    chown mabeltv:mabeltv "$recovery"
    chmod 0750 "$recovery"
    if [[ -f /etc/mabeltv/library.conf ]]; then
        cp -a /etc/mabeltv/library.conf "$recovery/library.conf"
        chown mabeltv:mabeltv "$recovery/library.conf"
    fi
    # Record recovery intent before clearing the credential. If power fails
    # after the database commit, the next boot reuses this verified export.
    pending_temporary="$(mktemp /var/lib/mabeltv/owner-recovery-pending.XXXXXX)"
    printf '%s\n' "$recovery" > "$pending_temporary"
    chown mabeltv:mabeltv "$pending_temporary"
    chmod 0640 "$pending_temporary"
    mv -f -- "$pending_temporary" "$pending"
    runuser --user mabeltv -- "$state_tool" reset-owner \
        --database /var/lib/mabeltv/mabeltv.db \
        --output "$recovery/owner.json"
else
    status=$?
    if ((status != 3)); then
        printf 'The SQLite owner state could not be verified; recovery was not attempted.\n' >&2
        exit "$status"
    fi
    # Resume safely if power failed after the owner was cleared.
    [[ -s "$pending" ]] || {
        printf 'SQLite has no owner and no recoverable reset is pending.\n' >&2
        exit 1
    }
    recovery="$(cat -- "$pending")"
    [[ "$recovery" == /var/lib/mabeltv/recovery/* && -s "$recovery/owner.json" ]] || {
        printf 'The pending owner recovery snapshot is invalid.\n' >&2
        exit 1
    }
fi

setup_code_number="$(( $(od -An -N4 -tu4 /dev/urandom) % 1000000 ))"
temporary="$(mktemp /etc/mabeltv/library.conf.XXXXXX)"
printf 'MABELTV_SETUP_CODE=%06d\n' "$setup_code_number" > "$temporary"
chown root:mabeltv "$temporary"
chmod 0640 "$temporary"
mv -f -- "$temporary" /etc/mabeltv/library.conf
rm -f -- "$marker"
logger -p auth.notice -t mabeltv-owner-recovery -- \
    "physical parent reset accepted; previous owner record saved in $recovery"
