[Unit]
Description=Mabel TV local Matter accessory for Alexa
After=network-online.target mabeltv.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=mabeltv
Group=mabeltv
WorkingDirectory=/var/lib/mabeltv/matter
Environment=HOME=/var/lib/mabeltv
EnvironmentFile=/etc/mabeltv/matter.conf
ExecStart=/usr/bin/node /opt/mabeltv/current/appliance/integrations/matter/mabeltv-matter.mjs --storage-path=/var/lib/mabeltv/matter/storage
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=8
UMask=0027
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/mabeltv/matter
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=false
MemoryHigh=180M
MemoryMax=300M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
