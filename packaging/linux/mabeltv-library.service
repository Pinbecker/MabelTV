[Unit]
Description=Mabel TV local media library
After=network-online.target local-fs.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=mabeltv
Group=mabeltv
WorkingDirectory=/var/lib/mabeltv
Environment=HOME=/var/lib/mabeltv
CacheDirectory=mabeltv
CacheDirectoryMode=0750
ExecStart=/opt/mabeltv/current/mabeltv-library --bind 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
KillMode=mixed
UMask=0027
MemoryHigh=220M
MemoryMax=400M
TasksMax=64
LimitNOFILE=1024
Nice=10
CPUQuota=125%
IOSchedulingClass=idle
# The service may invoke only the tightly scoped, passwordless refresh helper
# permitted in mabeltv-sudoers. NoNewPrivileges would block that sudo step.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/srv/mabeltv/media /var/lib/mabeltv /var/cache/mabeltv
ReadOnlyPaths=-/media/mabeltv-usb

[Install]
WantedBy=multi-user.target
