[Unit]
Description=Complete the KidsTV first-boot installation
Documentation=file:/usr/lib/mabeltv-bootstrap/image-build.json
Wants=cloud-final.service
After=local-fs.target rpi-resize.service cloud-final.service systemd-user-sessions.service multi-user.target
# cloud-final itself runs after multi-user.target. Ordering before that target
# would create a boot cycle. The image masks the TV's tty1 login instead.
ConditionPathExists=!/var/lib/mabeltv-image/provisioned

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mabeltv-image-firstboot
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target
