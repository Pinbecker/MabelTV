pragma ComponentBehavior: Bound

import QtQuick

// Pearl Silver, Mabel TV decorative surround.
// Self-contained QML: the approved artwork is embedded in this file.
// The picture opening and the area outside the cabinet are transparent.
// Geometry comes from the ORIGINAL TelevisionScreen.qml Slim Black formulas,
// including the small-window minimum insets and the original widescreen mode.
// This is a decorative overlay, not a replacement media player / OSD component.
// Example: PearlSilverSurround { id: tvFrame; appRoot: existingAppRoot }
// Existing picture content can use parent: tvFrame.screenItem;
// anchors.fill: parent. The surround masks its rounded corners from above.

Item {
    id: surround
    objectName: "PearlSilverSurround"

    property var appRoot: null
    property bool widescreen: appRoot ? appRoot.portalWidescreenEnabled : false
    readonly property string styleName: "Pearl Silver"

    implicitWidth: 1440
    implicitHeight: implicitWidth * (widescreen ? 0.64 : 3 / 4)
    anchors.centerIn: parent
    width: appRoot
        ? (widescreen
           ? Math.min(appRoot.width - 48, (appRoot.height - 48) / 0.64)
           : Math.min(appRoot.width - 48, (appRoot.height - 48) * 4 / 3))
        : implicitWidth
    height: width * (widescreen ? 0.64 : 3 / 4)

    // These calculations deliberately retain the source file's Math.max
    // minimums; using fixed percentages alone would change small-window sizing.
    readonly property real sideInset: Math.max(54, width * 0.070)
    readonly property real tubeWidth: widescreen ? width * 0.89
                                                : width - sideInset * 2
    readonly property real tubeHeight: tubeWidth * (widescreen ? 9 / 16 : 3 / 4)
    readonly property real tubeTop: widescreen ? width * 0.030
                                             : (height - tubeHeight) / 2
    readonly property real lipWidth: Math.max(12, width * 0.015)
    readonly property real radius: Math.max(38, width * 0.055)
    readonly property real screenX: (width - tubeWidth) / 2
    readonly property real screenY: tubeTop
    readonly property real screenWidth: tubeWidth
    readonly property real screenHeight: tubeHeight
    readonly property real screenRadius: Math.max(38, tubeWidth * 0.065)
    readonly property rect screenRect: Qt.rect(screenX, screenY,
                                              screenWidth, screenHeight)
    readonly property var screenItem: pictureSlot
    readonly property bool ready: paintSurface.sourceReady && paintSurface.rendered

    // Empty by default. The Canvas is painted above any picture added here.
    Item {
        id: pictureSlot
        objectName: "pictureSlot"
        x: surround.screenX
        y: surround.screenY
        width: surround.screenWidth
        height: surround.screenHeight
        clip: true
        z: 0
    }

    Canvas {
        id: paintSurface
        objectName: "surroundCanvas"
        anchors.fill: parent
        z: 1
        antialiasing: true
        renderTarget: Canvas.Image
        renderStrategy: Canvas.Immediate

        property bool sourceReady: false
        property bool rendered: false

        function ensureArtwork() {
            if (!available)
                return
            if (isImageLoaded(surround._artworkSource)) {
                sourceReady = true
                requestPaint()
            } else if (!isImageLoading(surround._artworkSource)) {
                loadImage(surround._artworkSource)
            }
        }

        Component.onCompleted: ensureArtwork()
        Component.onDestruction: {
            if (sourceReady)
                unloadImage(surround._artworkSource)
        }
        onAvailableChanged: {
            if (available)
                ensureArtwork()
        }
        onImageLoaded: {
            sourceReady = isImageLoaded(surround._artworkSource)
            if (!sourceReady)
                console.warn("PearlSilverSurround: embedded artwork did not load")
            requestPaint()
        }
        onWidthChanged: { rendered = false; requestPaint() }
        onHeightChanged: { rendered = false; requestPaint() }
        onPainted: rendered = sourceReady

        onPaint: {
            if (!available)
                return
            var ctx = getContext("2d")
            if (!ctx)
                return
            ctx.reset()
            ctx.clearRect(0, 0, width, height)
            if (!sourceReady || width <= 0 || height <= 0
                    || surround.screenWidth <= 0 || surround.screenHeight <= 0)
                return

            ctx.save()
            ctx.beginPath()
            ctx.roundedRect(0, 0, width, height, surround.radius, surround.radius)
            ctx.clip()
            ctx.fillStyle = "#bab6ad"
            ctx.fillRect(0, 0, width, height)

            // Separately map the casing, recessed lip and picture bands.
            // This compresses the previews' extra lower chin back into the
            // exact original geometry without scaling the whole border evenly.
            // Source coordinates belong to the embedded 1448 x 1086 artwork.
            var sx = [43, 118, 150, 1298, 1330, 1405]
            var sy = [30, 85, 113, 951, 973, 1055]
            var x = surround.screenX
            var y = surround.screenY
            var w = surround.screenWidth
            var h = surround.screenHeight
            var lip = surround.lipWidth
            var dx = [0, x - lip, x, x + w, x + w + lip, width]
            var dy = [0, y - lip, y, y + h, y + h + lip, height]

            for (var row = 0; row < 5; ++row) {
                for (var col = 0; col < 5; ++col) {
                    var dw = dx[col + 1] - dx[col]
                    var dh = dy[row + 1] - dy[row]
                    if (dw <= 0 || dh <= 0)
                        continue
                    // Paint through an overlapping clip, avoiding Canvas's
                    // cropped-image sampling seams at fractional boundaries.
                    var scaleX = dw / (sx[col + 1] - sx[col])
                    var scaleY = dh / (sy[row + 1] - sy[row])
                    ctx.save()
                    ctx.beginPath()
                    ctx.rect(dx[col] - 0.6, dy[row] - 0.6, dw + 1.2, dh + 1.2)
                    ctx.clip()
                    ctx.drawImage(surround._artworkSource,
                                  dx[col] - sx[col] * scaleX,
                                  dy[row] - sy[row] * scaleY,
                                  1448 * scaleX, 1086 * scaleY)
                    ctx.restore()
                }
            }
            ctx.restore()

            // Actual alpha removal, not a black, white or checkerboard fill.
            // Nothing, including a glass reflection or sticker, remains in
            // the original rounded picture opening.
            ctx.globalCompositeOperation = "destination-out"
            ctx.fillStyle = "#000000"
            ctx.beginPath()
            ctx.roundedRect(x, y, w, h, surround.screenRadius, surround.screenRadius)
            ctx.fill()
            ctx.globalCompositeOperation = "source-over"
        }
    }

    // Embedded lossless source artwork. No image files or network are required.
    readonly property url _artworkSource: "data:image/png;base64,"
}
